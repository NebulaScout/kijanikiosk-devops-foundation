# ─── Stage 1: Builder ────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install ALL dependencies (including devDependencies needed to compile)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source and compile
COPY . .
RUN npm run build
# Output is in /app/out

# ─── Stage 2: Production ─────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS production 

# 1. Install wget for healthcheck (nginx:alpine doesn't have curl by default)
# 2. Create the 'kijani' user and group
RUN apk add --no-cache wget && \
    addgroup -S kijani && \
    adduser -S kijani -G kijani

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
# Note: Using /app/out as specified in your comments
COPY --from=builder /app/out /usr/share/nginx/html

# 3. Fix permissions for nginx temp directories and html folder for the non-root user
# Nginx needs write access to cache/temp folders even when running as non-root
RUN chown -R kijani:kijani /usr/share/nginx/html && \
    chown -R kijani:kijani /var/cache/nginx && \
    chown -R kijani:kijani /var/log/nginx && \
    chown -R kijani:kijani /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown kijani:kijani /var/run/nginx.pid

# 4. Define the Healthcheck
# Checks every 10s, allows 60s start period (grace period), times out in 5s
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3001/ || exit 1

# 5. Switch to the non-root user
USER kijani

EXPOSE 3001

CMD ["nginx", "-g", "daemon off;"]   