pipeline {
    agent any

    environment {
        STAGING_NAMESPACE    = 'kijani-staging'
        PRODUCTION_NAMESPACE = 'default'
        MANIFEST_ROOT        = 'kijani-capstone/k8s'
        // KUBECTL_VERSION = '1.31.0'
        // KUSTOMIZE_VERSION = 'v5.4.3'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
//         stage('Install CLI Tools') {
//     steps {
//         sh '''
//             set -euo pipefail
            
//             echo "Downloading kubectl..."
//             curl -LO "https://dl.k8s.io/release/v1.31.0/bin/linux/amd64/kubectl"
//             chmod +x kubectl
            
//             echo "Downloading kustomize..."
//             curl -LO "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F5.4.3/kustomize_5.4.3_linux_amd64.tar.gz"
//             tar -xzf kustomize_5.4.3_linux_amd64.tar.gz
            
//             # No need to move - files are already in current directory
//             echo "Verifying installation in current directory..."
//             ls -l kubectl kustomize
            
//             # Add current directory to PATH
//             export PATH="$PWD:$PATH"
//             echo "PATH updated: $PATH"
//         '''
//     }
// }


        // stage('Validate Kubernetes manifests') {
        //     steps {
        //         sh '''#!/usr/bin/env bash
        //             set -euo pipefail
        //             kubectl kustomize "${MANIFEST_ROOT}/overlays/staging" >/dev/null
        //             kubectl kustomize "${MANIFEST_ROOT}/overlays/production" >/dev/null
        //         '''
        //     }
        // }

        stage('Validate Kubernetes manifests') {
    steps {
        withKubeConfig([credentialsId: 'kijanikiosk-kubeconfig', serverUrl: '']) {
            script {
                // This runs inside a container with kubectl/kustomize pre-installed
                sh "kubectl kustomize '${MANIFEST_ROOT}/overlays/staging' >/dev/null"
                sh "kubectl kustomize '${MANIFEST_ROOT}/overlays/production' >/dev/null"
            }
        }
    }
}

        stage('Deploy staging') {
    when {
        branch 'develop'
    }
    steps {
        // This replaces your withCredentials block
        withKubeConfig([
            credentialsId: 'kijanikiosk-kubeconfig', 
            // serverUrl is optional. If you leave it empty, Jenkins uses the context from the kubeconfig file itself.
            serverUrl: '' 
        ]) {
            sh '''
                set -euo pipefail
                # No need to set KUBECONFIG env var manually; withKubeConfig handles it
                kubectl --namespace "${STAGING_NAMESPACE}" apply -k "${MANIFEST_ROOT}/overlays/staging"
                kubectl --namespace "${STAGING_NAMESPACE}" rollout status deployment/kk-payments --timeout=180s
            '''
        }
    }
}

        stage('Smoke test staging') {
            when {
                branch 'develop'
            }
            steps {
                withCredentials([file(credentialsId: 'kijanikiosk-kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        smoke_pod="kk-payments-smoke-${BUILD_NUMBER}"

                        # This runs inside kijani-staging, proving both the Service DNS
                        # route and the workload health endpoint work after the rollout.
                        kubectl --namespace "${STAGING_NAMESPACE}" run "${smoke_pod}" \
                          --image=curlimages/curl:8.12.1 \
                          --restart=Never \
                          --rm \
                          --attach \
                          --command -- \
                          curl --fail --show-error --silent --max-time 10 \
                          http://kk-payments:3001/health
                    '''
                }
            }
        }

        stage('Approve production deployment') {
            when {
                branch 'develop'
            }
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            steps {
                input message: 'Staging rollout and smoke test passed. Deploy kk-payments to production?',
                      ok: 'Deploy production',
                      submitterParameter: 'PRODUCTION_APPROVER'
            }
        }

        stage('Deploy production') {
            when {
                branch 'develop'
            }
            steps {
                withCredentials([file(credentialsId: 'kijanikiosk-kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        kubectl --namespace "${PRODUCTION_NAMESPACE}" apply -k "${MANIFEST_ROOT}/overlays/production"
                        kubectl --namespace "${PRODUCTION_NAMESPACE}" rollout status deployment/kk-payments --timeout=180s
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Production is not deployed unless the failure occurred after approval.'
        }
    }
}
