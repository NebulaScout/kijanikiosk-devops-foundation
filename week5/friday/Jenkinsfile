pipeline {
    agent {
        docker {
            // Requirement: Pinned Node.js image (not 'latest') to ensure reproducibility
            image 'node:18.19.0-alpine3.18'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        NEXUS_URL = 'http://localhost:8081/repository/npm-kijanikiosk/'
        NEXUS_REPO_NAME = 'npm-kijanikiosk'
        ARTIFACT_NAME = 'kijani-kiosk'
        // Version derived from package.json or build metadata, not hardcoded
        APP_VERSION = sh(script: 'node -p "require(\'./package.json\').version"', returnStdout: true).trim()
        BUILD_TIMESTAMP = sh(script: 'date -u +"%Y-%m-%dT%H:%M:%SZ"', returnStdout: true).trim()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Requirement: Lint stage before Build (Fail-Fast Principle)
        stage('Lint') {
            steps {
                script {
                    echo "Running ESLint on commit ${env.GIT_COMMIT}"
                    sh 'npm ci --ignore-scripts' // Clean install without running scripts yet
                    sh 'npm run lint'
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    echo "Building version ${env.APP_VERSION}"
                    sh 'npm run build'
                }
            }
        }

        // Requirement: Parallel Verify stage (Test and Security Audit)
        stage('Verify') {
            parallel {
                stage('Test') {
                    steps {
                        script {
                            echo "Running Unit Tests"
                            // Generate JUnit XML for post-build analysis
                            sh 'npm run test -- --ci --reporters=default --reporters=jest-junit'
                        }
                    }
                }
                stage('Security Audit') {
                    steps {
                        script {
                            echo "Running Security Audit (npm audit)"
                            // Fail build if high/critical vulnerabilities found
                            sh 'npm audit --audit-level=high'
                        }
                    }
                }
            }
        }

        // Requirement: Archive stage with artifact fingerprinting
        stage('Archive') {
            steps {
                script {
                    echo "Archiving and Fingerprinting Artifact"
                    // Create a tarball of the build output
                    sh "tar -czvf ${env.ARTIFACT_NAME}-${env.APP_VERSION}.tar.gz dist/"
                    
                    // Generate SHA256 checksum for integrity verification
                    sh "sha256sum ${env.ARTIFACT_NAME}-${env.APP_VERSION}.tar.gz > ${env.ARTIFACT_NAME}-${env.APP_VERSION}.tar.gz.sha256"
                    
                    // Archive artifacts in Jenkins for immediate access and evidence
                    archiveArtifacts artifacts: "${env.ARTIFACT_NAME}-${env.APP_VERSION}.tar.gz, ${env.ARTIFACT_NAME}-${env.APP_VERSION}.tar.gz.sha256", fingerprint: true
                }
            }
        }

        // Requirement: Publish stage with secure Nexus authentication
        stage('Publish') {
            steps {
                script {
                    // withCredentials ensures secrets are masked and scoped to this block
                    withCredentials([usernamePassword(credentialsId: 'nexus-credentials-id', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                        sh '''
                            # Create .npmrc dynamically within the shell step
                            cat > .npmrc <<EOF
                            registry=${NEXUS_URL}/repository/${NEXUS_REPO_NAME}/
                            //${NEXUS_URL#http://}:8081/repository/${NEXUS_REPO_NAME}/:_authToken=${NEXUS_PASS}
                            always-auth=true
                            EOF

                            echo "Publishing ${ARTIFACT_NAME}@${APP_VERSION} to Nexus"
                            
                            # Publish to Nexus (using npm publish or curl depending on repo type)
                            # Assuming a generic npm publish workflow configured via .npmrc
                            npm publish --registry ${NEXUS_URL}/repository/${NEXUS_REPO_NAME}/
                            
                            # Verify upload by checking existence (optional but recommended for evidence)
                            # curl -u ${NEXUS_USER}:${NEXUS_PASS} -I ${NEXUS_URL}/repository/${NEXUS_REPO_NAME}/${ARTIFACT_NAME}/-/${ARTIFACT_NAME}-${APP_VERSION}.tgz

                            # Securely delete .npmrc immediately after use
                            rm -f .npmrc
                            echo ".npmrc securely deleted"
                        '''
                    }
                }
            }
        }
    }

    // Requirement: Comprehensive post block
    post {
        always {
            // Workspace cleanup to prevent disk exhaustion and cross-build contamination
            cleanWs()
            // Publish test results regardless of outcome
            junit allowEmptyResults: true, testResults: '**/junit-*.xml'
        }
        success {
            script {
                // Log the specific artifact URL for downstream consumption
                def nexusUrl = "${env.NEXUS_URL}/repository/${env.NEXUS_REPO_NAME}/${env.ARTIFACT_NAME}/-/${env.ARTIFACT_NAME}-${env.APP_VERSION}.tgz"
                echo "✅ BUILD SUCCESS: Artifact available at ${nexusUrl}"
                // Optionally send a Slack/Email notification here with the URL
            }
        }
        failure {
            script {
                echo "❌ BUILD FAILED: Check console output for details."
                // Trigger failure notification (e.g., email to committers or Slack alert)
                // mail to: 'team@example.com', subject: "Failed: ${env.JOB_NAME}", body: "Check ${env.BUILD_URL}"
            }
        }
        changed {
            script {
                // Notify only when the build status changes (e.g., from Failure to Success)
                def currentBuild = currentBuild
                if (currentBuild.previousBuild != null) {
                    def prevResult = currentBuild.previousBuild.result
                    def currentResult = currentBuild.currentResult
                    if (prevResult != currentResult) {
                        echo "🔄 STATUS CHANGED: From ${prevResult} to ${currentResult}"
                        // Send status transition notification
                    }
                }
            }
        }
    }
}   